# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows shell redirection artifact (`>nul` accidentally creates this
# file in the working directory). Keep it out of the repo.
# The literal "nul" name conflicts with Windows' NUL device, so quote it.
/nul

# Local-only install helper + log, not part of the buildable project.
/install-deps.bat
/install-deps.log
